{
    "name": "inventory",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "dotenv -e .env -- concurrently -n API,WEB -c blue.bold,green.bold \"npm:dev:api\" \"npm:dev:web\"",
        "dev:api": "npm run start:dev --workspace=apps/api",
        "dev:web": "npm run dev --workspace=apps/web"
    },
    "devDependencies": {
        "concurrently": "^9.1.2",
        "dotenv-cli": "^8.0.0"
    }
}
